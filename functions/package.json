{
  "name": "functions",
  "version": "1.0.0",
  "type": "module",
  "main": "./lib/index.js",
  "exports": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "logs": "firebase functions:log",
    "build": "npm run clear && npm run lint && npm run compile",
    "build:watch": "npm run clear && npm run lint && npm run compile:watch",
    "clear": "rm -rf ./lib",
    "compile": "tsc -p ./tsconfig.json --pretty",
    "compile:watch": "tsc --watch -p ./tsconfig.json --pretty",
    "eslint": "eslint",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fabricelements/shared-helpers": "file:..",
    "express": "^4.18.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  },
  "overrides": {},
  "private": true
}
