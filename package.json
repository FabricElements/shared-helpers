{
  "name": "@fabricelements/shared-helpers",
  "description": "Shared TypeScript helpers for Node.js and Firebase.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "author": "Erny Sans",
  "license": "BSD-3-Clause",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabricElements/shared-helpers.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./user": "./lib/user.js",
    "./media": "./lib/media.js",
    "./bigquery-stream-writer": "./lib/bigquery-stream-writer.js",
    "./firestore-helper": "./lib/firestore-helper.js",
    "./filter-helper": "./lib/filter-helper.js",
    "./bigquery-identifier": "./lib/bigquery-identifier.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.5.0",
    "@google-cloud/bigquery-storage": "^6.3.0",
    "@google-cloud/pubsub": "^6.3.2",
    "libphonenumber-js": "^1.13.15",
    "lodash": "^4.18.1",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "firebase-admin": "^14.0.0",
    "firebase-functions": "7.4.0"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": false
    },
    "firebase-functions": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "7.4.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "eslint": "^10.13.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clear && npm run lint && npm run compile",
    "build:watch": "npm run clear && npm run lint && npm run compile:watch",
    "clear": "rm -rf ./lib",
    "compile": "tsc -p ./tsconfig.json",
    "compile:watch": "tsc --watch -p ./tsconfig.json",
    "eslint": "eslint",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  }
}
