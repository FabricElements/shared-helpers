{
  "name": "@fabricelements/shared-helpers",
  "description": "Shared TypeScript helpers for Node.js and Firebase.",
  "type": "module",
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "author": "Erny Sans",
  "license": "BSD-3-Clause",
  "version": "2.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabricElements/shared-helpers.git"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./user": "./lib/user.js",
    "./media": "./lib/media.js",
    "./bigquery-stream-writer": "./lib/bigquery-stream-writer.js",
    "./firestore-helper": "./lib/firestore-helper.js",
    "./bigquery-identifier": "./lib/bigquery-identifier.js"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.3.1",
    "@google-cloud/bigquery-storage": "^5.1.1",
    "@google-cloud/pubsub": "^5.0.0",
    "libphonenumber-js": "^1.13.10",
    "lodash": "^4.18.1",
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "firebase-admin": "^13.10.0 || ^14.0.0",
    "firebase-functions": "^7.3.2"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": false
    },
    "firebase-functions": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/node": "^25.9.2",
    "eslint": "^10.8.1",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint": "^10.8.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run clear && npm run lint && npm run compile",
    "build:watch": "npm run clear && npm run lint && npm run compile:watch",
    "clear": "rm -rf ./lib",
    "compile": "tsc -p ./tsconfig.json",
    "compile:watch": "tsc --watch -p ./tsconfig.json",
    "eslint": "eslint",
    "lint": "eslint",
    "lint:fix": "eslint --fix"
  }
}
